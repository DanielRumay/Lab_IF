pipeline {
  agent any

  environment {
    TF_IN_AUTOMATION        = "true"
    AWS_REGION              = "us-east-1"
    AWS_ACCESS_KEY_ID       = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY   = credentials('AWS_SECRET_ACCESS_KEY')
  }

  options {
    skipStagesAfterUnstable()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Lint Terraform') {
      steps {
        dir('terraform') {
          sh '''
            echo "🔍 Ejecutando terraform fmt..."
            terraform fmt -check -recursive

            echo "🔍 Ejecutando tflint..."
            tflint || true
          '''
        }
      }
    }

    stage('Validar Terraform') {
      steps {
        dir('terraform') {
          sh '''
            echo "🧪 Validando configuración..."
            terraform validate
          '''
        }
      }
    }

    stage('Empaquetar Lambda') {
      steps {
        dir('terraform') {
          sh 'zip lambda.zip lambda_function.py'
        }
      }
    }

    stage('Test') {
      steps {
        dir('terraform') {
          sh 'pytest test_lambda.py || true'
        }
      }
    }

    stage('Terraform Init') {
      steps {
        dir('terraform') {
          sh '''
        echo 🚀 Ejecutando terraform init...
        terraform init -upgrade
      '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        dir('terraform') {
          sh 'terraform plan -var-file=terraform.tfvars'
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        input message: '¿Deseas aplicar los cambios con Terraform?'
        dir('terraform') {
          sh 'terraform apply -auto-approve -var-file=terraform.tfvars'
        }
      }
    }

    stage('Deploy Frontend') {
      steps {
        dir('frontend-site') {
          sh '''
            aws s3 sync . s3://recetas-frontend \
              --region ${AWS_REGION} \
              --delete
          '''
        }
      }
    }

    stage('Mostrar URL del API') {
      steps {
        dir('terraform') {
          sh '''
            echo "🔗 URL del API:"
            terraform output api_invoke_url
          '''
        }
      }
    }

    stage('Run Checkov') {
      steps {
        dir('ci_cd') {
          sh 'bash checkov_scan.sh || true'
        }
      }
    }
  }

  post {
    failure {
      echo "❌ La ejecución del pipeline falló."
    }
    success {
      echo "✅ Pipeline ejecutado correctamente."
    }
  }
}